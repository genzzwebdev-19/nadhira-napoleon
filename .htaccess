# ============================================
# HTACCESS - NADHIRA NAPOLEON PEKANBARU
# ============================================

# Enable Rewrite Engine
RewriteEngine On

# ============================================
# SECURITY HEADERS
# ============================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS — hanya berlaku saat situs diakses via HTTPS (browser mengabaikannya di HTTP)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header set Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=()"
    # CSP: inline script/style tetap diizinkan (situs memakai banyak inline),
    # sumber eksternal di-whitelist (CDN font-awesome + GSAP, Google Fonts, Midtrans, YouTube/IG, Cloudinary)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://app.sandbox.midtrans.com https://app.midtrans.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' https:; media-src 'self' https:; frame-src 'self' https://app.sandbox.midtrans.com https://app.midtrans.com https://www.youtube.com https://www.instagram.com; object-src 'none'; base-uri 'self'; form-action 'self' https:;"
</IfModule>

# ============================================
# PREVENT DIRECTORY LISTING
# ============================================
Options -Indexes

# ============================================
# PROTECT SENSITIVE FILES
# ============================================
<FilesMatch "\.(env|sql|md|log|json)$">
    Require all denied
</FilesMatch>

# Folder uploads/backups & uploads/payments dilindungi oleh .htaccess-nya sendiri

# ============================================
# PHP INFORMATION DISCLOSURE (best effort)
# ============================================
<IfModule mod_php.c>
    php_flag expose_php Off
    php_flag display_errors Off
</IfModule>

# ============================================
# BLOCK GIT / VCS METADATA EXPOSURE
# ============================================
# Mencegah .git (riwayat & source code) diunduh publik bila folder repo
# ikut ter-upload ke hosting.
RewriteRule (^|/)\.git(/|$) - [F,L]

# ============================================
# PROTECT APPLICATION INTERNALS (config, includes)
# ============================================
# Catatan: <FilesMatch> hanya mencocokkan NAMA FILE (basename), bukan path,
# sehingga pola ber-slash di atas tidak pernah berfungsi. Karena itu pakai
# RewriteRule yang mencocokkan path asli:
#   - config/   : berisi kredensial DB & rahasia API -> WAJIB diblokir
#   - includes/ : file server-side -> diblokir
# ajax/ & database/ sengaja TIDAK diblokir:
#   - ajax/     : dipanggil frontend via fetch()
#   - database/ : installer dilindungi INSTALL_KEY (config/database.php)
RewriteRule ^(config|includes)/ - [F,L]

# ============================================
# CACHING
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    
    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ============================================
# COMPRESSION
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain text/xml image/svg+xml
</IfModule>

# ============================================
# ERROR PAGES
# ============================================
# Path berikut untuk hosting di ROOT domain (public_html).
# Jika aplikasi ditaruh di subfolder (mis. public_html/nad/),
# ubah menjadi /nad/404.php sesuai lokasinya.
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php
ErrorDocument 500 /404.php

# ============================================
# URL REWRITING (Optional - for clean URLs)
# ============================================
# Redirect product pages
# RewriteRule ^produk/([a-z0-9-]+)$ /nad/pages/product-detail.php?slug=$1 [L,QSA]
# RewriteRule ^kategori/([a-z0-9-]+)$ /nad/pages/products.php?category=$1 [L,QSA]

# Redirect to index.php for clean URLs
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^(.*)$ index.php [L]

# Force HTTPS (uncomment when SSL is configured)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
